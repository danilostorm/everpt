<?xml version="1.0" encoding="UTF-8"?>
<!-- Etervale in the browser - IIS settings for the site folder. assets\web.config has the settings for the game data. -->
<configuration>
	<appSettings>
		<!-- ports of the game server the bridge (ws.ashx) may connect to, on this computer -->
		<add key="EtervaleGamePorts" value="10009" />
	</appSettings>

	<system.web>
		<!-- ws.ashx is compiled by ASP.NET 4.x; WebSockets need the 4.5+ runtime behaviour -->
		<compilation targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />
	</system.web>

	<system.webServer>
		<!-- the game uses threads (SharedArrayBuffer): browsers allow them only on pages
		     sent with these headers, and only over HTTPS -->
		<httpProtocol>
			<customHeaders>
				<add name="Cross-Origin-Opener-Policy" value="same-origin" />
				<add name="Cross-Origin-Embedder-Policy" value="require-corp" />
				<add name="Cross-Origin-Resource-Policy" value="same-origin" />
			</customHeaders>
		</httpProtocol>

		<staticContent>
			<remove fileExtension=".br" />
			<mimeMap fileExtension=".br" mimeType="application/octet-stream" />
			<remove fileExtension=".wasm" />
			<mimeMap fileExtension=".wasm" mimeType="application/wasm" />
			<remove fileExtension=".dat" />
			<mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
			<remove fileExtension=".json" />
			<mimeMap fileExtension=".json" mimeType="application/json" />
			<remove fileExtension=".js" />
			<mimeMap fileExtension=".js" mimeType="text/javascript" />
			<remove fileExtension=".mjs" />
			<mimeMap fileExtension=".mjs" mimeType="text/javascript" />
			<remove fileExtension=".xnb" />
			<mimeMap fileExtension=".xnb" mimeType="application/octet-stream" />
			<remove fileExtension=".mgfxo" />
			<mimeMap fileExtension=".mgfxo" mimeType="application/octet-stream" />
			<!-- the page and program change with updates: browsers check for a newer copy -->
			<clientCache cacheControlMode="DisableCache" />
		</staticContent>

		<!-- never served: the git clone and the toolchain folder kept next to the site -->
		<security>
			<requestFiltering>
				<hiddenSegments>
					<add segment="GIT" />
					<add segment=".git" />
					<add segment="project" />
				</hiddenSegments>
			</requestFiltering>
		</security>

		<!-- the build's precompressed copies, for browsers that accept them: the program is a quarter of its size -->
		<rewrite>
			<rules>
				<rule name="Precompressed brotli" stopProcessing="true">
					<match url="^(_framework/.*|[^/]+\.(?:js|json))$" />
					<conditions>
						<add input="{HTTP_ACCEPT_ENCODING}" pattern="br" />
						<add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
					</conditions>
					<action type="Rewrite" url="{R:1}.br" />
				</rule>
			</rules>
			<outboundRules>
				<rule name="Brotli encoding" preCondition="Precompressed">
					<match serverVariable="RESPONSE_Content-Encoding" pattern=".*" />
					<action type="Rewrite" value="br" />
				</rule>
				<rule name="Wasm type" preCondition="PrecompressedWasm">
					<match serverVariable="RESPONSE_Content-Type" pattern=".*" />
					<action type="Rewrite" value="application/wasm" />
				</rule>
				<rule name="Script type" preCondition="PrecompressedScript">
					<match serverVariable="RESPONSE_Content-Type" pattern=".*" />
					<action type="Rewrite" value="text/javascript" />
				</rule>
				<rule name="Json type" preCondition="PrecompressedJson">
					<match serverVariable="RESPONSE_Content-Type" pattern=".*" />
					<action type="Rewrite" value="application/json" />
				</rule>
				<preConditions>
					<preCondition name="Precompressed"><add input="{URL}" pattern="\.br$" /></preCondition>
					<preCondition name="PrecompressedWasm"><add input="{URL}" pattern="\.wasm\.br$" /></preCondition>
					<preCondition name="PrecompressedScript"><add input="{URL}" pattern="\.m?js\.br$" /></preCondition>
					<preCondition name="PrecompressedJson"><add input="{URL}" pattern="\.json\.br$" /></preCondition>
				</preConditions>
			</outboundRules>
		</rewrite>

		<defaultDocument enabled="true">
			<files>
				<clear />
				<add value="index.html" />
			</files>
		</defaultDocument>
	</system.webServer>
</configuration>
