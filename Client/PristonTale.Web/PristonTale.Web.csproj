<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <!-- The game in the browser: the same client as Client/PristonTale, on the web runtime of monogame/web. Build with
         build_web.ps1, which passes EtervaleWeb=true to the whole project graph. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>disable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>false</InvariantGlobalization>
        <WasmEnableThreads>true</WasmEnableThreads>
        <RunAOTCompilation>true</RunAOTCompilation>
        <WasmBuildNative>true</WasmBuildNative>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <EmccInitialHeapSize>536870912</EmccInitialHeapSize>
        <EmccMaximumHeapSize>4294901760</EmccMaximumHeapSize>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <UseSystemResourceKeys>false</UseSystemResourceKeys>
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="*.cs" />
        <Compile Include="../PristonTale/**/*.cs" Exclude="../PristonTale/Program.cs;../PristonTale/bin/**;../PristonTale/obj/**;../PristonTale/Display/DisplayValidationProbe*.cs" LinkBase="Linked" />
        <EmccExportedRuntimeMethod Include="FS" />
        <ProjectReference Include="../PristonTale.Gameplay/PristonTale.Gameplay.csproj" />
        <EmbeddedResource Include="../PristonTale/Icon.bmp" LogicalName="Icon.bmp" />
        <EmbeddedResource Include="../PristonTale/Icon.ico" LogicalName="Icon.ico" />
        <TrimmerRootAssembly Include="PristonTale.Gameplay" />
        <TrimmerRootAssembly Include="PristonTale.Effects" />
        <TrimmerRootAssembly Include="PristonTale.Engine3D" />
        <TrimmerRootAssembly Include="PristonTale.Client.Net" />
        <TrimmerRootAssembly Include="PristonTale.Simulation" />
        <TrimmerRootAssembly Include="PristonTale.Protocol" />
        <TrimmerRootAssembly Include="MonoGame.Framework" />
    </ItemGroup>
</Project>
